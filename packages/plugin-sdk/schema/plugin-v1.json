{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alpine.dev/schemas/plugin-v1.json",
  "title": "Alpine Shell plugin manifest",
  "type": "object",
  "required": ["id", "name", "version", "apiVersion"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "apiVersion": { "type": "integer", "minimum": 1 },
    "engines": { "type": "object", "properties": { "alpineShell": { "type": "string" } } },
    "description": { "type": "string" },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" }, "url": { "type": "string" }, "email": { "type": "string" } }
    },
    "homepage": { "type": "string" },
    "repository": { "type": "string" },
    "license": { "type": "string" },
    "icon": { "type": "string" },
    "renderer": { "type": "string" },
    "main": { "type": "string" },
    "contributes": {
      "type": "object",
      "properties": {
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "type", "label", "default"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
              "type": { "type": "string", "enum": ["toggle", "select", "slider"] },
              "label": { "type": "string", "minLength": 1 },
              "info": { "type": "string" },
              "default": { "type": ["boolean", "string", "number"] },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["value", "label"],
                  "properties": { "value": { "type": "string" }, "label": { "type": "string", "minLength": 1 } }
                }
              },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "step": { "type": "number", "exclusiveMinimum": 0 },
              "unit": { "type": "string" },
              "since": { "type": "integer" }
            },
            "allOf": [
              {
                "if": { "properties": { "type": { "const": "toggle" } } },
                "then": { "properties": { "default": { "type": "boolean" } } }
              },
              {
                "if": { "properties": { "type": { "const": "select" } } },
                "then": { "required": ["options"], "properties": { "default": { "type": "string" } } }
              },
              {
                "if": { "properties": { "type": { "const": "slider" } } },
                "then": { "required": ["min", "max"], "properties": { "default": { "type": "number" } } }
              }
            ]
          }
        },
        "settingsPages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "icon": { "type": "string" },
              "path": { "type": "string" },
              "topLevel": { "type": "boolean" },
              "export": { "type": "string", "minLength": 1 },
              "since": { "type": "integer" }
            }
          }
        }
      }
    },
    "marketplace": {
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "logo": { "type": "string" },
        "shortDescription": { "type": "string", "maxLength": 120 },
        "readme": { "type": "string" },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["src"],
            "properties": { "src": { "type": "string" }, "caption": { "type": "string" }, "dark": { "type": "boolean" } }
          }
        },
        "category": { "type": "string", "enum": ["productivity", "system", "media", "developer", "social", "fun", "other"] },
        "keywords": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
