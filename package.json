{
  "name": "alpine-shell-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": ["electron"],
  "scripts": {
    "postinstall": "bun --filter @alpine/plugin-sdk build",
    "sdk:build": "bun --filter @alpine/plugin-sdk build",
    "start": "bun scripts/start.js",
    "build": "bun --filter @alpine/plugin-sdk build && bun --filter alpine-shell build",
    "release": "bun --filter @alpine/plugin-sdk build && bun --filter alpine-shell release",
    "test": "bun --filter @alpine/plugin-sdk --filter alpine-shell test",
    "typecheck": "bun --filter @alpine/plugin-sdk --filter alpine-shell typecheck",
    "lint": "bun --filter alpine-shell lint"
  }
}
