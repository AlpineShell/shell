{
  "name": "alpine-shell-monorepo",
  "private": true,
  "packageManager": "bun",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun scripts/start.js",
    "build": "bun --filter alpine-shell build",
    "release": "bun --filter alpine-shell release",
    "web:build": "bun --filter @alpine/web build",
    "test": "bun --filter alpine-shell --filter @alpine/license test",
    "typecheck": "bun --filter alpine-shell --filter @alpine/license typecheck",
    "lint": "bun --filter alpine-shell lint"
  }
}
