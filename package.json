{
  "name": "alpine-shell",
  "main": "electron/main.js",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "node scripts/dev.js",
    "start:setup": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron . --setup\"",
    "build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@heroui/react": "^3.0.2",
    "@heroui/styles": "^3.0.2",
    "@tailwindcss/vite": "^4.2.1",
    "koffi": "^2.15.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "concurrently": "^9.2.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0-beta.13",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.alpine.shell",
    "productName": "Alpine Shell",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "public/cursor",
        "to": "cursor"
      },
      {
        "from": "electron/scripts",
        "to": "scripts"
      },
      {
        "from": "wallpapers",
        "to": "wallpapers"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
