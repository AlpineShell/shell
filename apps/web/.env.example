# apps/web/.env  — copy to `.env.local` (gitignored) for local dev, and set the
# same value in your web host's env (Vercel/Railway/etc.) for production.

# Public base URL where the plugin marketplace catalog + bundles are served.
# The /plugins pages read `plugins/index.json` and plugin detail from here.
# Point at your object store's PLUGINS bucket public-read base (trailing slash).
# Defaults to the Railway plugins public base if unset.
NEXT_PUBLIC_PLUGINS_BASE=https://bucket-production-xxxx.up.railway.app/alpine-plugins/
