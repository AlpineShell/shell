{
  "name": "alpine-shell",
  "main": "electron/main.js",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "node scripts/dev.js",
    "start:setup": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron . --setup\"",
    "build": "node scripts/generateGoogleCredentials.js && vite build && electron-builder --win",
    "release": "node scripts/generateGoogleCredentials.js && vite build && electron-builder --win --publish never && node scripts/publish.js",
    "publish": "node scripts/publish.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "koffi": "^2.15.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1076.0",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "concurrently": "^9.2.1",
    "electron": "40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^17.0.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0-beta.13",
    "vitest": "^3.0.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.alpine.shell",
    "productName": "Alpine Shell",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/koffi/build/koffi/**",
      "node_modules/koffi/build/koffi/win32_x64/**",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/vendor/**",
      "!node_modules/lightningcss-*/**",
      "!node_modules/@tailwindcss/oxide-*/**",
      "!dist/cursor/**",
      "!electron/**/*.test.js",
      "!electron/scripts/**"
    ],
    "extraResources": [
      {
        "from": "public/cursor",
        "to": "cursor",
        "filter": ["**/*", "!Bibata-Modern-Ice/**"]
      },
      {
        "from": "electron/scripts",
        "to": "scripts"
      },
      {
        "from": "wallpapers",
        "to": "wallpapers"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://pub-634a0706ca394cf7a0eedfa4f8a71a56.r2.dev/",
      "channel": "latest"
    }
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
