{
  "name": "alpine-shell",
  "main": "electron/main.js",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "node scripts/dev.js",
    "start:setup": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron . --setup\"",
    "build": "node scripts/generateMarketplaceConfig.js && node scripts/generateLicenceConfig.js && vite build && electron-builder --win",
    "release": "node scripts/generateMarketplaceConfig.js && node scripts/generateLicenceConfig.js && vite build && electron-builder --win --publish never && node scripts/publish.js",
    "publish": "node scripts/publish.js",
    "publish:plugin": "node scripts/publishPlugin.js",
    "screenshots:settings": "bun scripts/captureSettingsSheets.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "dependencies": {
    "@alpine/plugin-sdk": "workspace:*",
    "electron-updater": "^6.3.9",
    "htm": "^3.1",
    "koffi": "^2.15.1",
    "zustand": "^5"
  },
  "devDependencies": {
    "@alpine/ui": "file:vendor/alpine-ui-0.9.0.tgz",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1076.0",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "concurrently": "^9.2.1",
    "electron": "40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^17.0.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0-beta.13",
    "vitest": "^3.0.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.alpine.shell",
    "productName": "Alpine Shell",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/koffi/build/koffi/**",
      "node_modules/koffi/build/koffi/win32_x64/**",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/vendor/**",
      "!node_modules/lightningcss-*/**",
      "!node_modules/@tailwindcss/oxide-*/**",
      "!dist/cursor/**",
      "!electron/**/*.test.js",
      "!electron/scripts/**"
    ],
    "asarUnpack": [
      "electron/shellExecuteWorker.js",
      "electron/waitForHandleWorker.js",
      "electron/bluetoothWorker.js",
      "electron/bluetoothNative.js"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "extraResources": [
      {
        "from": "src/assets/fonts",
        "to": "licenses/fonts",
        "filter": ["OFL-*.txt"]
      },
      {
        "from": "public/cursor",
        "to": "cursor",
        "filter": ["**/*", "!Bibata-Original-Ice/**"]
      },
      {
        "from": "electron/scripts",
        "to": "scripts"
      },
      {
        "from": "wallpapers",
        "to": "wallpapers",
        "filter": ["**/*", "!CREDITS.md"]
      },
      {
        "from": "presets/plugins",
        "to": "plugins"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signExts": [".dll", ".node"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://auth.alpineshell.com/releases/",
      "channel": "latest",
      "useMultipleRangeRequest": false
    }
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
