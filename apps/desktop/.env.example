# Shared Google Calendar OAuth "Desktop app" client, baked into the build so
# users don't set up their own. Copy to `.env` (gitignored) and fill in from the
# Cloud Console. Public desktop client — safe to ship; PKCE secures sign-in.
# CI reads these from GitHub Actions secrets instead of this file.
ALPINE_GOOGLE_CLIENT_ID=
ALPINE_GOOGLE_CLIENT_SECRET=
