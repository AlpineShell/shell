# apps/desktop/.env  — copy this file to `.env` (gitignored) and fill in.
# In CI these values come from GitHub Actions secrets/variables, not this file.

# ─────────────────────────────────────────────────────────────────────────────
# Google Calendar sign-in runs through the auth service (AlpineShell/auth), which
# holds the Google client secret. Point it at a local auth service when needed.
# ─────────────────────────────────────────────────────────────────────────────
# ALPINE_AUTH_BASE=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# Object storage: Railway/MinIO (S3-compatible) is the store
# Used by:
#   scripts/publish.js        → installer + latest.yml   (release auto-update channel)
#   scripts/publishPlugin.js  → plugin bundle + catalog   (marketplace)
# Use the STORAGE_* vars; they point at Railway/MinIO. Set the bucket to whatever
# you're publishing:
#   alpine-plugins  → when running `bun run publish:plugin`
#   alpine-shell    → installer updates (normally done by CI, not locally)
# ─────────────────────────────────────────────────────────────────────────────

# --- Railway / MinIO (recommended) ---
STORAGE_ENDPOINT=              # S3 API endpoint, e.g. https://bucket-production-xxxx.up.railway.app  (the :9000 domain, NOT the console)
STORAGE_ACCESS_KEY_ID=         # MinIO access key (create a dedicated one, not root)
STORAGE_SECRET_ACCESS_KEY=     # MinIO secret key
STORAGE_BUCKET=alpine-plugins  # bucket for the thing you're publishing (see note above)
STORAGE_FORCE_PATH_STYLE=true  # required for MinIO
STORAGE_PUBLIC_URL=            # public read base w/ trailing slash, e.g. https://<endpoint>/alpine-plugins/
# STORAGE_REGION=              # optional; defaults to us-east-1

# The in-app marketplace (Settings → Plugins → Browse) reads its catalog from a
# public base URL. It defaults to STORAGE_PUBLIC_URL above; set ALPINE_PLUGINS_BASE
# to override (e.g. a CDN in front of the bucket). In dev this is read from .env;
# for packaged builds it is baked in by scripts/generateMarketplaceConfig.js.
# ALPINE_PLUGINS_BASE=

# ─────────────────────────────────────────────────────────────────────────────
# Plugin signing (Ed25519) — optional
# Private key used by scripts/publishPlugin.js to sign each plugin bundle.
# If UNSET, plugins publish UNSIGNED (fine for first-party bring-up; the install
# side marks them "Unverified"). The matching PUBLIC key is baked into the app.
# A release build refuses unsigned bundles. Generate the pair with the command in
# RELEASING.md: put the base64 private key here and the public half into
# ALPINE_MARKETPLACE_PUBKEY, which a release build bakes in.
# ─────────────────────────────────────────────────────────────────────────────
ALPINE_PLUGIN_SIGNING_KEY=
